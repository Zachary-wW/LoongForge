# Copy this file to an operator-managed path on a target runner.
# Do not commit the copy or include credentials in workflow logs.

LOONGFORGE_BASELINE_LLM_VLM=a
LOONGFORGE_BASELINE_EMBODIED=p
LOONGFORGE_HOST_DATA_ROOT=/workspace/runner-data
LOONGFORGE_CONTAINER_DATA_ROOT=/workspace/ci-data
LOONGFORGE_HOST_LLM_DATA_ROOT=/workspace/runner-llm-data
LOONGFORGE_CONTAINER_LLM_DATA_ROOT=/workspace/ci-llm-data
LOONGFORGE_HOST_OUTPUT_ROOT=/workspace/runner-logs
LOONGFORGE_CONTAINER_OUTPUT_ROOT=/workspace/ci-output
LOONGFORGE_CONTAINER_SOURCE=/workspace/LoongForge
LOONGFORGE_CONTAINER_SOURCE_MOUNT=/workspace/LoongForge-source
LOONGFORGE_CONTAINER_RETENTION_HOURS=24
LOONGFORGE_CANDIDATE_RETENTION_HOURS=24
LOONGFORGE_RUNNER_LOG_ROOT=/workspace/runner-run-logs
TRITON_LIBCUDA_PATH=/workspace/triton/libcuda

# Regression hooks.
LOONGFORGE_PULL_IMAGE=true
LOONGFORGE_DEFAULT_IMAGE=docker.io/library/ubuntu:24.04
# Set this to the runner-local accelerator device selector required by Docker.
LOONGFORGE_GPU_DEVICE=runner-local-gpu
LOONGFORGE_ALLOW_PR_IMAGE_BUILD=false
# Enable only on the protected runner selected by CI_RELEASE_RUNNER.
LOONGFORGE_ALLOW_RELEASE_IMAGE_BUILD=false
# Temporarily disable GPU release regression when the protected runner is busy.
# Set true when the release runner is available for deepseek_v2_lite and pi05_ddp.
LOONGFORGE_RELEASE_RUN_REGRESSION=false
# The prefix must match the operator-managed BASE_IMAGE used on the release
# runner. The current protected base image is Ubuntu 24.04, CUDA 13.3,
# PyTorch 2.13.0a0, and Python 3.12.
LOONGFORGE_RELEASE_IMAGE_TAG_PREFIX=ubuntu24.04-cu13.3-torch2.13.0a0-py312

# Optional capacity checks. An unset value uses the safe default; an explicitly
# empty value disables that check. GPU memory is MiB per device. Docker storage
# is GiB on the filesystem containing DockerRootDir.
LOONGFORGE_MIN_FREE_GPU_MB=60000
LOONGFORGE_MIN_DOCKER_FREE_GB=250

# Optional runner-local proxy settings. Keep these out of the repository and
# set them in the Actions runner service environment when external access is
# required. The build and regression hooks pass non-empty values through.
# HTTP_PROXY=your-proxy-host:8080
# HTTPS_PROXY=your-proxy-host:8080
# Include any direct-only public dependency hosts required by the build.
# NO_PROXY=127.0.0.1,localhost,.internal-object-store.example
# http_proxy=$HTTP_PROXY
# https_proxy=$HTTPS_PROXY
# no_proxy=$NO_PROXY

# Optional local candidate image repository name. It is never pushed.
CI_CANDIDATE_IMAGE_REPOSITORY=loongforge-ci
CANDIDATE_TAG_PREFIX=pr

# Candidate images are always local to the suite runner and are never pushed.
# This optional override must point to an operator-managed trusted Dockerfile.
# IMAGE_DOCKERFILE=/workspace/trusted/Dockerfile
# IMAGE_BASE_IMAGE=...

# Optional BuildKit secrets for internal mirrors. These files are managed on
# each runner and must not be committed or printed in workflow logs.
# IMAGE_APT_SOURCES=/workspace/runner-secrets/apt/sources.list
# IMAGE_PIP_CONFIG=/workspace/runner-secrets/pip/pip.conf
# IMAGE_SOURCE_MANIFEST=/workspace/runner-secrets/source-manifest.env
